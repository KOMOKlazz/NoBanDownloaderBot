# Токен от @BotFather (настоящий токен пиши только в .env, не сюда!)
BOT_TOKEN=123456:ABC...

# Кому разрешено пользоваться ботом (Telegram ID через запятую).
# Пусто = всем. Свой ID бот покажет по команде /start.
ALLOWED_USERS=

# Необязательно: файл cookies в формате Netscape рядом с bot.py.
# Нужен, только если какая-то соцсеть начнёт требовать вход (чаще всего YouTube на сервере).
COOKIES_FILE=

# Адрес локального Bot API сервера — снимает лимиты 50/20 МБ (до 2 ГБ). Пусто = обычный API.
LOCAL_BOT_API_URL=
